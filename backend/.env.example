# ---- Server ----
APP_NAME=Debugly
ENVIRONMENT=development

# ---- MongoDB ----
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=debugly

# ---- CORS ----
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:3000

# ---- Gemini (used from Phase 4; keep the key here, never in the frontend) ----
# Put your real key ONLY in backend/.env (gitignored), never in this example file.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ---- Auth (used from later phases) ----
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
